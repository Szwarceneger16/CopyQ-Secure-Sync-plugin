+bool materializeDataForReadback(QVariantMap *data, qint64 limit, bool confirmPersistence)
+{
+    if (!data || limit < 0 || limit > 32 * 1024 * 1024)
+        return false;
+    qint64 remaining = limit;
+    for (auto it = data->begin(); it != data->end(); ++it) {
+        if (it.value().metaType().id() == QMetaType::QByteArray) {
+            const auto size = it.value().toByteArray().size();
+            if (size > remaining)
+                return false;
+            remaining -= size;
+        } else if (it.value().metaType() == QMetaType::fromType<DataFile>()) {
+            const auto bytes = it.value().value<DataFile>().readBounded(remaining, confirmPersistence);
+            if (!bytes)
+                return false;
+            remaining -= bytes->size();
+            it.value() = *bytes;
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
