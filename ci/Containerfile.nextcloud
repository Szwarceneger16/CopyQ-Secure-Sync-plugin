# SPDX-License-Identifier: GPL-3.0-or-later
# Acceptance fixture only: official stock CopyQ and actual Nextcloud client.
FROM ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
RUN --mount=type=secret,id=proxy_ca \
    cqs_apt=(); if test -s /run/secrets/proxy_ca; then cqs_apt+=(-o Acquire::https::CaInfo=/run/secrets/proxy_ca); fi; \
    apt-get "${cqs_apt[@]}" update \
    && apt-get "${cqs_apt[@]}" install -y --no-install-recommends \
       ca-certificates xvfb openbox dbus-x11 python3 nextcloud-desktop-cmd \
       libssl3t64 zlib1g libx11-6 libxext6 libxcb1 libxkbcommon0 libxkbcommon-x11-0 \
       libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 \
       libxcb-xinerama0 libxcb-xkb1 libxcb-shape0 libxcb-randr0 libxcb-sync1 libxcb-xfixes0 \
       libgl1 libegl1 libopengl0 libx11-xcb1 libxcb-glx0 libfontconfig1 libdbus-1-3 \
       libpulse0 libsm6 libice6 libxrender1 libxtst6 \
    && rm -rf /var/lib/apt/lists/*
COPY squashfs-root /opt/copyq17
RUN chmod -R a+rX /opt/copyq17
