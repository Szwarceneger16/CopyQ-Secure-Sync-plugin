# SPDX-License-Identifier: GPL-3.0-or-later
# SDK preparation has network access; project builds/tests run separately offline.
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates build-essential cmake ninja-build git python3 python3-venv \
    pkg-config libssl-dev zlib1g-dev libgl1-mesa-dev libegl1-mesa-dev \
    libxkbcommon-dev libfontconfig1-dev libdbus-1-3 libxcb-cursor0 \
    libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 \
    libxcb-xinerama0 libxcb-xkb1 libxkbcommon-x11-0 libx11-xcb1 \
    libxcb-shape0 libxcb-randr0 libxcb-sync1 libxcb-xfixes0 libsm6 libice6 \
    libglib2.0-0t64 libxrender1 libxext6 \
    && rm -rf /var/lib/apt/lists/*
COPY toolchain.json /opt/cqs-toolchain.json
RUN python3 -m venv /opt/aqt \
    && /opt/aqt/bin/python -m pip install --disable-pip-version-check \
       "aqtinstall==$(python3 -c 'import json; print(json.load(open("/opt/cqs-toolchain.json"))["aqtinstall"])')" \
    && QT_VERSION=$(python3 -c 'import json; print(json.load(open("/opt/cqs-toolchain.json"))["qt"])') \
    && /opt/aqt/bin/python -m aqt install-qt linux desktop "$QT_VERSION" linux_gcc_64 \
       --outputdir /opt/Qt --archives qtbase icu qt5compat --modules qt5compat \
    && test -f "/opt/Qt/$QT_VERSION/gcc_64/lib/cmake/Qt6/Qt6Config.cmake" \
    && LD_LIBRARY_PATH="/opt/Qt/$QT_VERSION/gcc_64/lib" \
       "/opt/Qt/$QT_VERSION/gcc_64/bin/qmake" -query QT_VERSION \
    && ln -s "/opt/Qt/$QT_VERSION/gcc_64" /opt/qt
RUN QCA_COMMIT=$(python3 -c 'import json; print(json.load(open("/opt/cqs-toolchain.json"))["qca_commit"])') \
    && git init /opt/qca-source \
    && git -C /opt/qca-source fetch --depth 1 https://github.com/KDE/qca.git "$QCA_COMMIT" \
    && git -C /opt/qca-source checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/qca-source rev-parse HEAD)" = "$QCA_COMMIT" \
    && cmake -S /opt/qca-source -B /opt/qca-build -G Ninja \
       -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=/opt/qt -DCMAKE_INSTALL_PREFIX=/opt/qca \
       -DBUILD_WITH_QT6=ON -DBUILD_TESTS=OFF -DBUILD_TOOLS=OFF -DBUILD_PLUGINS=ossl \
    && cmake --build /opt/qca-build --parallel 2 \
    && cmake --install /opt/qca-build \
    && rm -rf /opt/qca-build /opt/qca-source
ENV PATH="/opt/qt/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/qca/lib:/opt/qt/lib" \
    QCA_PLUGIN_PATH="/opt/qca/lib/qca-qt6" \
    QT_QPA_PLATFORM="offscreen" \
    GIT_OPTIONAL_LOCKS="0"
# The workflow supplies an unprivileged numeric uid/gid and only explicit mounts.
WORKDIR /source
